# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (the Neon integration adds the DATABASE_* ones).

# --- Database (Neon, region: AWS Asia Pacific / Singapore) ---
# Pooled connection string (host contains "-pooler") for the running app:
DATABASE_URL=postgres://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct connection string, used only by `npm run db:migrate`:
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Local alternative: docker compose up -d, then
# DATABASE_URL=postgres://neondb_owner:localdev@localhost:5432/neondb

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: entra.microsoft.com → App registrations → New (multi-tenant + personal accounts)
# Redirect URI (Web): <BETTER_AUTH_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Email (Resend). Without a key, emails are printed to the server log. ---
RESEND_API_KEY=
EMAIL_FROM="Wellness Connect <no-reply@yourdomain.com>"

# --- Files (Vercel Blob, PRIVATE store). Added automatically when you connect a Blob store. ---
BLOB_READ_WRITE_TOKEN=

# --- Platform staff ---
# Comma-separated emails that become super admin once that email is verified.
SUPER_ADMIN_EMAILS=you@yourdomain.com

# --- Background jobs. Vercel Cron sends "Authorization: Bearer $CRON_SECRET". ---
CRON_SECRET=
